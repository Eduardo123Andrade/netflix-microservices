discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// "/observability-grafana-1" -> "observability-grafana-1"
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	// Nome do serviço no compose (grafana, prometheus, loki...).
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

// Lê os logs dos containers descobertos.
loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.loki.receiver]
}
// Envia pro Loki.
loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// Recebe logs (e depois métricas e traces) das aplicações via OTLP/HTTP.
otelcol.receiver.otlp "default" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		logs = [otelcol.processor.batch.default.input]
	}
}

// Agrupa em lotes antes de enviar.
otelcol.processor.batch "default" {
	output {
		logs = [otelcol.exporter.otlphttp.loki.input]
	}
}

// Entrega no endpoint OTLP nativo do Loki.
otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
	}
}
