{
  "name": "@netflix/users",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm db:generate && pnpm grpc:generate",
    "predev": "bash scripts/db-up.sh dev",
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "postdev": "bash scripts/db-down.sh dev",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "pnpm test:unit",
    "test:unit": "dotenv -e .env.test -- jest --testPathPatterns=__tests__/unit",
    "test:integration": "bash scripts/run-with-db.sh integration -- dotenv -e .env.integration -- jest --runInBand --testPathPatterns=__tests__/integration",
    "test:e2e": "bash scripts/run-with-db.sh e2e -- dotenv -e .env.e2e -- jest --runInBand --testPathPatterns=__tests__/e2e",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "db:up": "bash scripts/db-up.sh dev",
    "db:down": "bash scripts/db-down.sh dev",
    "db:migrate": "dotenv -e .env -- prisma migrate deploy",
    "db:migrate:create": "dotenv -e .env -- prisma migrate dev --create-only",
    "db:generate": "prisma generate",
    "grpc:generate": "buf generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "grpc-health-check": "^2.1.0",
    "pg": "^8.23.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "cookie-cjs": "npm:cookie@^1.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.15.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}